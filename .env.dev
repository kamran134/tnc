# Local dev stack env (docker-compose.dev.yml). Local throwaway values only -
# this DB is a disposable copy, nothing here is used in production.
DB_NAME=tnc_prod
DB_USERNAME=tnc_user
DB_PASSWORD=tnc_local_dev
JWT_SECRET=local-dev-secret-key-at-least-256-bits-long-000000000000000000
# Access/refresh TTL in ms, same defaults as prod (1 час / 30 дней).
# Для проверки refresh-flow локально временно поставь JWT_ACCESS_EXPIRATION_MS=60000
# (см. раздел "Проверка refresh локально" в DEV_LOCAL.md) и верни обратно после теста.
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=2592000000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GQPC41V59T
