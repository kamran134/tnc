# TNC Frontend Environment Variables

# Site URL for Open Graph and SEO (used in metadata)
# Development: http://localhost:3000
# Production: https://tnc.az
NEXT_PUBLIC_SITE_URL=https://tnc.az

# API Base URL
# Development: http://localhost:8080
# Production: https://tnc.az/api (через nginx reverse proxy)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
